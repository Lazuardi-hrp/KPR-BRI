# ── Supabase ────────────────────────────────────────────────────────────
# URL dan kunci publishable memang publik: yang melindungi data adalah RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# HANYA DI SERVER. Melewati RLS sepenuhnya. Jangan pernah diberi awalan
# NEXT_PUBLIC_. Ambil dari Dashboard > Project Settings > API keys > secret.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Prospek ─────────────────────────────────────────────────────────────
# Garam untuk hash IP. IP mentah tidak pernah disimpan (PRD §9.4, §13.1).
# Bangkitkan dengan: openssl rand -hex 32
LEAD_IP_SALT=

# ── Notifikasi (Edge Function) ──────────────────────────────────────────
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# ── Anti-bot (opsional) ─────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Situs ───────────────────────────────────────────────────────────────
# Dipakai juga untuk menyusun tautan halaman perumahan di dalam pesan
# WhatsApp. Tanpa nilai ini pesannya tetap terkirim, hanya tanpa tautan.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── WhatsApp ────────────────────────────────────────────────────────────
# Nomor tim KPR pusat, CADANGAN dari app_settings `public.whatsapp`
# (migrasi 0023). Yang di basis data menang — ia bisa dikoreksi tim BRI
# sendiri tanpa deploy. Isi salah satunya saja. Kosong = tombol WhatsApp
# pusat tidak dirender sama sekali; kontak per perumahan tetap berjalan.
NEXT_PUBLIC_WHATSAPP_KPR=
